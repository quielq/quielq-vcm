__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/
*.egg-info/
dist/
build/

# local secrets/config — copy from settings.example.toml
configs/settings.toml

# local media library, reminders storage
media/
data/reminders.json
# home server state (python -m vcm.home.server): lamp, timers, log
data/home_state.json

# downloaded dataset caches (SLURP/FSC/etc. raw metadata+audio) — re-fetch, don't commit
data/external/

# generated by scripts/build_manifest.py — depends entirely on data/external/, regenerate don't commit
data/dataset_manifest.csv
# base manifest + data/external/targeted_synth, from scripts/add_targeted_synth_to_manifest.py
data/dataset_manifest_targeted.csv
# Experiment 32 manifests and slot labels (scripts/build_manifest.py,
# add_targeted_synth_to_manifest.py, build_slot_labels.py)
data/dataset_manifest_v2.csv
data/dataset_manifest_pre_exp32.csv
data/dataset_manifest_exp32.csv
data/slot_labels.csv
# your own recordings (scripts/record_wakeword.py, record_real_examples.py): personal voice data
data/wakeword_real/
data/real_recordings/

# generated by scripts/transcribe_corpus_for_cascade.py — depends entirely on
# data/external/ audio, regenerate don't commit (also large, 62K+ rows)
data/cascade_transcripts.csv

# generated by scripts/generate_distillation_labels.py — depends on
# data/cascade_transcripts.csv + checkpoints/cascade_classifier.joblib,
# regenerate don't commit
data/distillation_labels.csv

# training run outputs — regenerate via vcm.train.train, don't commit
checkpoints/
logs/

# scripts/demo_infer.py --debug output — local diagnostic recordings
debug_recordings/

# macOS Finder metadata
.DS_Store

# per-machine Claude Code settings
.claude/settings.local.json

# Piper TTS voices (~60 MB each): downloaded on the device, see DEPLOYMENT.md
models/tts/
